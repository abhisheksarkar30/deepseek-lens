#!/bin/sh
# Rejects commits whose message doesn't start with GI#<id>.
# Installed automatically via core.hooksPath (see build.gradle.kts).

COMMIT_MSG_FILE="$1"
FIRST_LINE=$(head -n1 "$COMMIT_MSG_FILE")

if ! echo "$FIRST_LINE" | grep -qiE '^GI#[0-9]+'; then
  echo "ERROR: commit message must start with 'GI#<issue-number>', e.g. 'GI#12 feat: add X'." >&2
  echo "Got: $FIRST_LINE" >&2
  exit 1
fi
